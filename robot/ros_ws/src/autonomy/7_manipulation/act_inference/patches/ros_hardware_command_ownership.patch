+    hardware_interface::return_type UFRobotSystemHardware::perform_command_mode_switch(
+        const std::vector<std::string>& start_interfaces,
+        const std::vector<std::string>& stop_interfaces)
+    {
+        unsigned int claimed = claimed_arm_interfaces_.load();
+        for (size_t i = 0; i < info_.joints.size(); ++i) {
+            const std::string command = info_.joints[i].name +
+                (velocity_control_ ? "/velocity" : "/position");
+            for (const auto& stopped : stop_interfaces) {
+                if (stopped == command) claimed &= ~(1u << i);
+            }
+            for (const auto& started : start_interfaces) {
+                if (started == command) claimed |= (1u << i);
+            }
+        }
+        claimed_arm_interfaces_.store(claimed);
+        return hardware_interface::return_type::OK;
+    }
