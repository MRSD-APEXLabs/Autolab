<!-- NAVIGATION -->
<launch>
    <arg name="sim" default="true" />

    <group>

        <node pkg="navigation_controller" exec="navigation_controller" namespace="navigation_controller"
        output="screen">
        </node>

        <node pkg="swerve_hardware_interface" exec="swerve_hardware_interface_node"
              namespace="swerve_hardware_interface" output="screen" unless="$(var sim)">
            <param from="$(find-pkg-share swerve_hardware_interface)/config/swerve_modules.yaml" />
        </node>

    </group>  
</launch>