  <version>0.0.0</version>
  <description>Drives real TalonFX/CANcoder swerve modules from the joint_command/joint_states contract via CTRE Phoenix6.</description>
  <maintainer email="jpuerto96@hotmail.com">Juan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>phoenix6</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
