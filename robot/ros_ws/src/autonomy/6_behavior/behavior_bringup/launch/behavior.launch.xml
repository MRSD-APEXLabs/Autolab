<launch>
    <group>
        <!-- Absolute, so the executives land on /$(env ROBOT_NAME)/behavior/* however this file is launched
             (by hand or through robot_bringup). The rest of the robot stack is not namespaced. -->
        <push-ros-namespace namespace="/$(env ROBOT_NAME)/behavior" />

        <!-- Behavior Tree -->
        <node pkg="behavior_tree" exec="behavior_tree_implementation">
            <param name="config" value="$(find-pkg-share behavior_tree)/config/drone.tree" />
            <param name="timeout" value="1.0" />
        </node>

        <!-- Behavior Executive -->
        <node pkg="behavior_executive" exec="behavior_executive"
            output="screen">
            <!-- remap glue to AutoLab -->
            <remap from="is_armed" to="/interface/is_armed" />
            <!-- topics -->
            <remap from="has_control" to="/interface/has_control" />
            <!-- services -->
            <remap from="robot_command" to="/interface/robot_command" />
            <remap from="set_trajectory_mode" to="/trajectory_controller/set_trajectory_mode" />
            <!-- <remap from="get_random_walk_plan" to="/global/get_random_walk_plan" /> -->
            <remap from="state_estimate_timed_out" to="/drone_safety_monitor/state_estimate_timed_out" />
            <remap from="set_recording_status" to="/bag_record/set_recording_status" />
            <remap from="reset_stuck" to="/droan/reset_stuck" />
            <remap from="clear_map" to="/droan/clear_map" />
            <remap from="stuck" to="/droan/stuck" />

        </node>

        <!-- Lab Machine Executive -->
        <include file="$(find-pkg-share lab_machine_executive)/launch/lab_machine_executive.launch.xml" />

        <!-- Navigation Executive -->
        <include file="$(find-pkg-share navigation_executive)/launch/navigation_executive.launch.xml" />

        <!-- Manipulation Executive -->
        <include file="$(find-pkg-share manipulation_executive)/launch/manipulation_executive.launch.xml" />

    </group>
</launch>
