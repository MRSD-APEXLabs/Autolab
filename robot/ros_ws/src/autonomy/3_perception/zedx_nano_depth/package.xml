<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zedx_nano_depth</name>
  <version>0.1.0</version>
  <description>Depth for the ZED X Nano stereo feed: rectifies the left/right pair from its CameraInfo and publishes a 16UC1 depth image (mm) aligned to the rectified left image, using RAFT-Stereo on the GPU or OpenCV SGBM.</description>
  <maintainer email="arnavkha@andrew.cmu.edu">Arker123</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- launch/zedx_nano_depth.launch.xml includes the camera launch file (with_camera:=true) -->
  <exec_depend>zedx_nano_camera</exec_depend>
  <!-- backend:=neural also needs PyTorch with CUDA; it is not in rosdep, install it in the Python environment -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
