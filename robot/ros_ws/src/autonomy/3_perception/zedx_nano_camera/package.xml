<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zedx_nano_camera</name>
  <version>0.1.0</version>
  <description>ZED X and ZED X Nano stereo feeds from the Xavier camera hub's MJPEG server (no ZED SDK on this machine): compressed and raw images plus factory-calibrated CameraInfo with stereo rectification, and a node that switches the hub between the cameras.</description>
  <maintainer email="arnavkha@andrew.cmu.edu">Arker123</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
