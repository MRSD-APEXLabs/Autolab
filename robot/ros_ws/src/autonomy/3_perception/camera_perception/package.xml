<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_perception</name>
  <version>0.1.0</version>
  <description>AprilTag poses, YOLO detections (oriented boxes, boxes or masks) located with the stereo depth, and a point cloud, from the rectified image and depth of the ZED X or ZED X Nano (zedx_nano_depth). Publishes the topics the Autolab pc3.py bridge published (/inspect/..., /servo/..., /zed_pointcloud).</description>
  <maintainer email="arnavkha@andrew.cmu.edu">Arker123</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- image + depth pairing (zedx_nano_depth.sync); launch/perception.launch.xml can include camera_ui's cameras.launch.xml -->
  <exec_depend>zedx_nano_depth</exec_depend>
  <exec_depend>camera_ui</exec_depend>
  <!-- pip, not rosdep: pupil-apriltags, ultralytics (see requirements.txt) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
