Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 0.25
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Mobile Base + Arm
      Enabled: true
      Alpha: 1
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.15
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_common/Group
      Name: ZED X
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Image
          Name: Left RGB
          Enabled: true
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /autolab/zed_x/left/image_rect
          Value: true
        - Class: rviz_default_plugins/Image
          Name: Left Depth
          Enabled: false
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /autolab/zed_x/left/depth_ground_truth
          Value: false
        - Class: rviz_default_plugins/PointCloud2
          Name: Point Cloud
          Enabled: true
          Alpha: 0.85
          Axis: Z
          Color Transformer: AxisColor
          Decay Time: 0.5
          Invert Rainbow: false
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.01
          Style: Points
          Topic:
            Depth: 2
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /autolab/zed_x/left/pointcloud
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
    - Class: rviz_common/Group
      Name: ZED X Nano
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Image
          Name: Left RGB
          Enabled: true
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /autolab/zed_x_nano/left/image_rect
          Value: true
        - Class: rviz_default_plugins/Image
          Name: Left Depth
          Enabled: false
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /autolab/zed_x_nano/left/depth_ground_truth
          Value: false
        - Class: rviz_default_plugins/PointCloud2
          Name: Point Cloud
          Enabled: true
          Alpha: 0.85
          Axis: Z
          Color Transformer: AxisColor
          Decay Time: 0.5
          Invert Rainbow: false
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.006
          Style: Points
          Topic:
            Depth: 2
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /autolab/zed_x_nano/left/pointcloud
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.45
      Target Frame: world
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1440
