<!-- ROBOT -->
<launch>

  <arg name="sim" default="true" />
  <arg name="record_bag" default="false" />
  <arg name="navigation" default="true"
       description="real robot: also start navigation (autonomy/1_navigation/run.sh) as its own process" />
  <arg name="navigation_hardware" default="true"
       description="true: run.sh --hardware, THE SWERVE DRIVETRAIN IS ENABLED. false: phoenix6 simulator" />

  <!-- No robot namespace here: nodes keep their own (mostly root) names. Only the behavior layer, which the GCS
       commands, lives under /$(env ROBOT_NAME)/behavior (set in behavior.launch.xml). -->

  <set_parameter name="use_sim_time" value="true" if="$(var sim)" />

  <!-- Sim -->
  <group if="$(var sim)">
    <include file="$(find-pkg-share robot_bringup)/launch/sim.launch.xml" />
  </group>
  <!-- Real -->
  <group unless="$(var sim)">
    <include file="$(find-pkg-share robot_bringup)/launch/real.launch.xml" />
  </group>

  <!-- On real hardware planning_bringup publishes the full calibrated robot
       model. A second publisher here gives Chassis_1 a conflicting parent. -->
  <!-- (each include in a group: keeps its launch args from leaking into the includes after it) -->
  <group if="$(var sim)">
    <include file="$(find-pkg-share robot_bringup)/launch/robot_state_publisher.launch.py">
      <arg name="robot_name" value="$(env ROBOT_NAME)" />
      <arg name="urdf_file_path" value="$(env ROBOT_URDF_FILE_PATH)" />
      <arg name="ignore_timestamp" value="true" />
      <arg name="use_sim_time" value="$(var sim)" />
    </include>
  </group>

  <!-- Static TFs for simulation connection -->
  <group>
    <include file="$(find-pkg-share robot_bringup)/launch/static_transforms.launch.xml">
      <arg name="robot_namespace" value="$(env ROBOT_NAME)" />
    </include>
  </group>

  <!-- Autonomy -->
  <group>
    <include
      file="$(find-pkg-share $(env AUTONOMY_LAUNCH_PACKAGE))/launch/$(env AUTONOMY_LAUNCH_FILE)">
      <arg name="sim" value="$(var sim)" />
    </include>
  </group>

  <!-- Navigation (real robot): exactly what running autonomy/1_navigation/run.sh by hand does, as a child process.
       run.sh keeps navigation on its own ROS domain (42), Fast DDS transport and tf2 fix overlay; navigation_executive
       bridges /nav/* across. With hardware it brings the CANivore up; the Xbox pad (the e-stop) may be connected
       later. Its yes flag replaces the typed YES, which a launch cannot answer. A failed CANivore bring-up leaves the
       rest of the stack running. -->
  <group unless="$(var sim)">
    <group if="$(var navigation)">
      <executable if="$(var navigation_hardware)" name="navigation" output="screen"
                  cmd="/home/robot/AutoLab/robot/ros_ws/src/autonomy/1_navigation/run.sh --hardware --yes" />
      <executable unless="$(var navigation_hardware)" name="navigation" output="screen"
                  cmd="/home/robot/AutoLab/robot/ros_ws/src/autonomy/1_navigation/run.sh" />
    </group>
  </group>

  <!-- Logging -->
  <!-- <include file="$(find-pkg-share logging_bringup)/launch/logging.launch.xml" /> -->

  <!-- Domain Bridge -->
  <node pkg="domain_bridge" exec="domain_bridge"
    args="/home/robot/AutoLab/robot/ros_ws/src/robot_bringup/params/domain_bridge.yaml"
    output="screen" respawn="true" respawn_delay="1" />

</launch>
