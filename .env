PROJECT_NAME="autolab"
DOCKER_IMAGE_TAG="0.1.0"
PROJECT_DOCKER_REGISTRY="docker.io/arker123"

AUTOLAUNCH="true"

ISAAC_SIM_GUI="/root/Autolab/simulation/isaac-sim/OT-2_removedoor.usd"
# Set to "true" to launch Isaac Sim using a standalone Python script instead of USD file
ISAAC_SIM_USE_STANDALONE_SCRIPT="false"
# Script name (must be in /Autolab/simulation/isaac-sim/launch_scripts/)
ISAAC_SIM_SCRIPT_NAME="robot_init.py"
PLAY_SIM_ON_START="false" # Not supported in standalone script mode