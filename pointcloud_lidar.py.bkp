#!/usr/bin/env python3

import asyncio
import base64
import json
import zlib
from typing import Any, Dict, List, Optional

import cv2
import numpy as np
import websockets
from scipy.spatial import KDTree

import os

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy

from sensor_msgs.msg import Image, PointCloud2, PointField
from visualization_msgs.msg import Marker, MarkerArray
from std_msgs.msg import Header
from cv_bridge import CvBridge
import sensor_msgs_py.point_cloud2 as pc2


#WS_URI = "ws://192.168.10.7:8766"
WS_URI = "ws://192.168.1.101:8766"
FRAME_ID = "top_camera"
MERGED_FRAME_ID = "velodyne"
USE_PC_CACHE = True   # False = never load/save point cloud caches
PC_CACHE_PATH = "./pc3_accumulated.npy"
LIDAR_TOPIC = "/velodyne_points"
LIDAR_PC_CACHE_PATH = "./vlp16_accumulated.npy"
TRANSFORM_PATH = "./mobility/transform_annotated.npy"


def _normalize_zed(pts: np.ndarray) -> np.ndarray:
    out = pts.astype(np.float64)
    out[:, 1] *= -1   # Y down → Y up
    return out

def _normalize_vlp16(pts: np.ndarray) -> np.ndarray:
    out = np.empty_like(pts, dtype=np.float64)
    out[:, 0] = -pts[:, 1]   # right  = -Y_lidar
    out[:, 1] =  pts[:, 2]   # up     =  Z_lidar
    out[:, 2] =  pts[:, 0]   # fwd    =  X_lidar
    return out

def _apply_transform(T: np.ndarray, pts: np.ndarray) -> np.ndarray:
    h = np.hstack([pts, np.ones((len(pts), 1))])
    return (T @ h.T).T[:, :3]


# ---------------------------------------------------------------------------
# Obstacle detection helpers
# ---------------------------------------------------------------------------

GROUND_RANSAC_ITERS   = 100
GROUND_RANSAC_THRESH  = 0.06   # m — points within this dist of plane = ground
GROUND_MIN_INLIERS    = 0.3    # fraction of cloud needed to accept plane
DBSCAN_EPS            = 0.20   # m — neighbourhood radius
DBSCAN_MIN_PTS        = 15     # minimum points to form a cluster
OBS_MIN_POINTS        = 20     # drop clusters smaller than this
OBS_MAX_DIM           = 6.0    # m — drop clusters larger than this (walls/noise)


def _remove_ground(pts: np.ndarray):
    """RANSAC plane fit on pts. Returns (above_ground, ground_mask)."""
    best_mask = np.zeros(len(pts), dtype=bool)
    best_count = 0
    rng = np.random.default_rng(42)

    for _ in range(GROUND_RANSAC_ITERS):
        idx = rng.choice(len(pts), 3, replace=False)
        p0, p1, p2 = pts[idx]
        normal = np.cross(p1 - p0, p2 - p0)
        norm_len = np.linalg.norm(normal)
        if norm_len < 1e-6:
            continue
        normal /= norm_len
        # Bias toward horizontal planes (Y-up frame, ground normal ≈ [0,1,0])
        if abs(normal[1]) < 0.7:
            continue
        dists = np.abs((pts - p0) @ normal)
        mask = dists < GROUND_RANSAC_THRESH
        count = mask.sum()
        if count > best_count:
            best_count = count
            best_mask = mask

    if best_count < len(pts) * GROUND_MIN_INLIERS:
        return pts, np.zeros(len(pts), dtype=bool)   # no convincing ground found

    return pts[~best_mask], best_mask


def _dbscan(pts: np.ndarray):
    """Return integer label array (-1 = noise). Pure scipy KDTree DBSCAN."""
    tree = KDTree(pts)
    neighbors = tree.query_ball_point(pts, DBSCAN_EPS, workers=-1)
    core = np.array([len(n) >= DBSCAN_MIN_PTS for n in neighbors])

    labels = np.full(len(pts), -1, dtype=np.int32)
    cluster_id = 0

    for i in range(len(pts)):
        if labels[i] != -1 or not core[i]:
            continue
        stack = [i]
        labels[i] = cluster_id
        while stack:
            p = stack.pop()
            for q in neighbors[p]:
                if labels[q] == -1:
                    labels[q] = cluster_id
                    if core[q]:
                        stack.append(q)
        cluster_id += 1

    return labels


def _geom_label(w: float, h: float, d: float) -> str:
    """Geometric heuristic label from bounding box dimensions (m)."""
    largest = max(w, d)
    if h > 1.4 and largest < 1.0:
        return "person"
    if largest > 2.5:
        return "large obstacle"
    if h < 0.3:
        return "low obstacle"
    return "obstacle"


DBSCAN_VOXEL = 0.08   # m — downsample before clustering; keeps ~5-15k pts


def _voxel_downsample(pts: np.ndarray, voxel: float) -> np.ndarray:
    idx = np.floor(pts / voxel).astype(np.int32)
    _, inv = np.unique(idx, axis=0, return_inverse=True)
    centroids = np.zeros((inv.max() + 1, 3), dtype=np.float64)
    counts = np.zeros(inv.max() + 1, dtype=np.int32)
    np.add.at(centroids, inv, pts)
    np.add.at(counts, inv, 1)
    return (centroids / counts[:, None]).astype(np.float32)


def detect_obstacles(merged: np.ndarray) -> List[Dict]:
    """
    Full obstacle detection pipeline on merged XYZ cloud.
    Returns list of dicts: centroid, bbox (min/max XYZ), distance, label, n_points.
    Frame: X right, Y up, Z forward.
    """
    pts = merged[np.isfinite(merged).all(1)]
    if len(pts) < DBSCAN_MIN_PTS:
        return []

    above, _ = _remove_ground(pts)
    if len(above) < DBSCAN_MIN_PTS:
        return []

    ds = _voxel_downsample(above, DBSCAN_VOXEL)
    labels = _dbscan(ds)
    obstacles = []

    for cid in np.unique(labels):
        if cid == -1:
            continue
        cluster = ds[labels == cid]
        if len(cluster) < OBS_MIN_POINTS:
            continue

        mn, mx = cluster.min(0), cluster.max(0)
        dims = mx - mn  # w(X), h(Y), d(Z)
        if any(dims > OBS_MAX_DIM):
            continue

        centroid = cluster.mean(0)
        dist = float(np.linalg.norm(centroid[[0, 2]]))  # horizontal distance

        obstacles.append({
            "centroid": centroid,
            "min": mn,
            "max": mx,
            "dims": dims,
            "distance": dist,
            "n_points": len(cluster),
            "label": _geom_label(*dims),
        })

    obstacles.sort(key=lambda o: o["distance"])
    return obstacles


class WSVisualizer(Node):
    def __init__(self):
        super().__init__("ws_visualizer")

        qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            history=HistoryPolicy.KEEP_LAST,
            depth=1,
        )
        pc_qos = QoSProfile(
            reliability=ReliabilityPolicy.RELIABLE,
            history=HistoryPolicy.KEEP_LAST,
            depth=1,
        )

        self.bridge = CvBridge()

        self._pcs: Optional[np.ndarray] = None
        self._lidar_pcs: Optional[np.ndarray] = None
        self._lidar_frame_id = "velodyne"

        if os.path.exists(TRANSFORM_PATH):
            self._merge_transform: Optional[np.ndarray] = np.load(TRANSFORM_PATH)
            self.get_logger().info(f"Loaded merge transform from {TRANSFORM_PATH}")
        else:
            self._merge_transform = None
            self.get_logger().warn(f"No merge transform found at {TRANSFORM_PATH} — merged cloud disabled")

        if USE_PC_CACHE and os.path.exists(PC_CACHE_PATH):
            self._pcs = np.load(PC_CACHE_PATH)
            self.get_logger().info(
                f"Loaded cached point cloud from {PC_CACHE_PATH} ({self._pcs.shape[0]} points)"
            )
        if USE_PC_CACHE and os.path.exists(LIDAR_PC_CACHE_PATH):
            self._lidar_pcs = np.load(LIDAR_PC_CACHE_PATH)
            self.get_logger().info(
                f"Loaded cached LiDAR point cloud from {LIDAR_PC_CACHE_PATH} "
                f"({self._lidar_pcs.shape[0]} points)"
            )

        # Servo topics
        self.servo_image_pub = self.create_publisher(Image, "/servo/image", qos)
        self.servo_det_pub = self.create_publisher(MarkerArray, "/servo/detections", qos)
        self.servo_target_pub = self.create_publisher(Marker, "/servo/target", qos)
        self.servo_annot_pub = self.create_publisher(Image, "/servo/annotated_image", qos)

        # Inspect topics
        self.inspect_image_pub = self.create_publisher(Image, "/inspect/image", qos)
        self.inspect_pc_pub = self.create_publisher(PointCloud2, "/zed_pointcloud", pc_qos)
        self.lidar_pc_pub = self.create_publisher(PointCloud2, "/vlp16_accumulated", pc_qos)
        self.merged_pc_pub = self.create_publisher(PointCloud2, "/merged_pointcloud", pc_qos)
        self.obstacles_pub = self.create_publisher(MarkerArray, "/obstacles/markers", qos)
        self.inspect_wp_pub = self.create_publisher(MarkerArray, "/inspect/wellplates", qos)
        self.inspect_tag_pub = self.create_publisher(MarkerArray, "/inspect/apriltags", qos)
        self.inspect_annot_pub = self.create_publisher(Image, "/inspect/annotated_image", qos)
        self.lidar_sub = self.create_subscription(
            PointCloud2,
            LIDAR_TOPIC,
            self.lidar_callback,
            qos,
        )

        self.get_logger().info("WS visualizer initialized")

    def header(self, frame_id: str = FRAME_ID) -> Header:
        h = Header()
        h.stamp = self.get_clock().now().to_msg()
        h.frame_id = frame_id
        return h

    def decode_image(self, b64: str) -> Optional[np.ndarray]:
        if not b64:
            return None
        try:
            img_bytes = base64.b64decode(b64)
            np_arr = np.frombuffer(img_bytes, dtype=np.uint8)
            return cv2.imdecode(np_arr, cv2.IMREAD_COLOR)
        except Exception as e:
            self.get_logger().error(f"Image decode error: {e}")
            return None

    def decode_pointcloud(self, b64: str, shape: List[int], dtype: str) -> Optional[np.ndarray]:
        if not b64 or not shape or not dtype:
            return None
        try:
            raw = zlib.decompress(base64.b64decode(b64))
            pc = np.frombuffer(raw, dtype=np.dtype(dtype)).reshape(shape)
            return pc[:, :3]
        except Exception as e:
            self.get_logger().error(f"Pointcloud decode error: {e}")
            return None

    def create_pc2(self, points: np.ndarray, frame_id: str = FRAME_ID) -> PointCloud2:
        fields = [
            PointField(name="x", offset=0, datatype=PointField.FLOAT32, count=1),
            PointField(name="y", offset=4, datatype=PointField.FLOAT32, count=1),
            PointField(name="z", offset=8, datatype=PointField.FLOAT32, count=1),
        ]
        return pc2.create_cloud(self.header(frame_id), fields, points.tolist())

    def create_pc2_rgb(self, points: np.ndarray, colors: np.ndarray, frame_id: str = FRAME_ID) -> PointCloud2:
        """points: Nx3 float32 XYZ. colors: Nx3 uint8 RGB."""
        fields = [
            PointField(name="x", offset=0, datatype=PointField.FLOAT32, count=1),
            PointField(name="y", offset=4, datatype=PointField.FLOAT32, count=1),
            PointField(name="z", offset=8, datatype=PointField.FLOAT32, count=1),
            PointField(name="rgb", offset=12, datatype=PointField.FLOAT32, count=1),
        ]
        rgb_u32 = (
            (colors[:, 0].astype(np.uint32) << 16)
            | (colors[:, 1].astype(np.uint32) << 8)
            | colors[:, 2].astype(np.uint32)
        )
        rgb_packed = rgb_u32.view(np.float32)
        cloud = np.empty((len(points), 4), dtype=np.float32)
        cloud[:, :3] = points
        cloud[:, 3] = rgb_packed
        return pc2.create_cloud(self.header(frame_id), fields, cloud.tolist())

    def _publish_merged(self):
        if self._merge_transform is None or self._pcs is None or self._lidar_pcs is None:
            return
        zed_norm = _normalize_zed(self._pcs[:, :3])
        vlp_norm = _normalize_vlp16(self._lidar_pcs[:, :3])
        vlp_aligned = _apply_transform(self._merge_transform, vlp_norm)
        merged = np.vstack([zed_norm, vlp_aligned]).astype(np.float32)

        colors = np.empty((len(merged), 3), dtype=np.uint8)
        colors[:len(zed_norm)] = (0, 0, 255)      # zed point cloud = blue
        colors[len(zed_norm):] = (255, 0, 0)      # velodyne = red
        self.merged_pc_pub.publish(self.create_pc2_rgb(merged, colors, MERGED_FRAME_ID))
        self._publish_obstacles(merged)

    def _publish_obstacles(self, merged: np.ndarray):
        obstacles = detect_obstacles(merged)
        markers = MarkerArray()

        clear = Marker()
        clear.action = Marker.DELETEALL
        markers.markers.append(clear)

        for i, obs in enumerate(obstacles):
            c = obs["centroid"]
            mn, mx = obs["min"], obs["max"]
            dims = obs["dims"]
            label = obs["label"]
            dist = obs["distance"]

            # Bounding box cube
            box = Marker()
            box.header = self.header(MERGED_FRAME_ID)
            box.ns = "obstacles"
            box.id = i
            box.type = Marker.CUBE
            box.action = Marker.ADD
            box.pose.position.x = float((mn[0] + mx[0]) / 2)
            box.pose.position.y = float((mn[1] + mx[1]) / 2)
            box.pose.position.z = float((mn[2] + mx[2]) / 2)
            box.pose.orientation.w = 1.0
            box.scale.x = max(float(dims[0]), 0.05)
            box.scale.y = max(float(dims[1]), 0.05)
            box.scale.z = max(float(dims[2]), 0.05)
            box.color.r = 1.0 if label == "person" else 0.9
            box.color.g = 0.3 if label == "person" else 0.6
            box.color.b = 0.0
            box.color.a = 0.4
            markers.markers.append(box)

            # Text label
            txt = Marker()
            txt.header = self.header(MERGED_FRAME_ID)
            txt.ns = "obstacles_text"
            txt.id = 1000 + i
            txt.type = Marker.TEXT_VIEW_FACING
            txt.action = Marker.ADD
            txt.pose.position.x = float(c[0])
            txt.pose.position.y = float(mx[1]) + 0.1
            txt.pose.position.z = float(c[2])
            txt.pose.orientation.w = 1.0
            txt.scale.z = 0.08
            txt.color.r = 1.0
            txt.color.g = 1.0
            txt.color.b = 1.0
            txt.color.a = 1.0
            txt.text = f"{label} {dist:.1f}m"
            markers.markers.append(txt)

        self.obstacles_pub.publish(markers)
        if obstacles:
            self.get_logger().info(
                f"Obstacles: {len(obstacles)} detected — "
                + ", ".join(f"{o['label']} @{o['distance']:.1f}m" for o in obstacles[:5])
            )

    def lidar_callback(self, msg: PointCloud2):
        if msg.header.frame_id:
            self._lidar_frame_id = msg.header.frame_id

        try:
            points = pc2.read_points(
                msg,
                field_names=("x", "y", "z"),
                skip_nans=True,
            )
            pc = np.asarray(points)
            if pc.dtype.fields is not None:
                pc = np.column_stack((pc["x"], pc["y"], pc["z"])).astype(np.float32)
            else:
                pc = pc.reshape(-1, 3).astype(np.float32)
        except Exception as e:
            self.get_logger().error(f"LiDAR pointcloud decode error: {e}")
            return

        if pc.size == 0:
            self.get_logger().warn("Received empty LiDAR point cloud")
            return

        self._lidar_pcs = pc
        if USE_PC_CACHE:
            np.save(LIDAR_PC_CACHE_PATH, self._lidar_pcs)

        self.lidar_pc_pub.publish(
            self.create_pc2(self._lidar_pcs, self._lidar_frame_id)
        )
        self._publish_merged()

    def _make_text_marker(
        self,
        ns: str,
        idx: int,
        x: float,
        y: float,
        z: float,
        text: str,
        r: float,
        g: float,
        b: float,
    ) -> Marker:
        m = Marker()
        m.header = self.header()
        m.ns = ns
        m.id = idx
        m.type = Marker.TEXT_VIEW_FACING
        m.action = Marker.ADD
        m.pose.position.x = x
        m.pose.position.y = y
        m.pose.position.z = z
        m.pose.orientation.w = 1.0
        m.scale.z = 0.06
        m.color.r = r
        m.color.g = g
        m.color.b = b
        m.color.a = 1.0
        m.text = text
        return m

    def _pose_to_marker_pose(self, m: Marker, pose: Dict[str, Any]):
        pos = pose.get("position", [0.0, 0.0, 0.0])
        quat = pose.get("orientation", [0.0, 0.0, 0.0, 1.0])

        m.pose.position.x = float(pos[0])
        m.pose.position.y = float(pos[1])
        m.pose.position.z = float(pos[2])

        # Expected quaternion order from server: [x, y, z, w]
        m.pose.orientation.x = float(quat[0])
        m.pose.orientation.y = float(quat[1])
        m.pose.orientation.z = float(quat[2])
        m.pose.orientation.w = float(quat[3])

    def servo_detections_to_markers(self, dets: List[Dict[str, Any]]) -> MarkerArray:
        markers = MarkerArray()

        # Clear previous markers in RViz
        clear = Marker()
        clear.action = Marker.DELETEALL
        markers.markers.append(clear)

        for i, d in enumerate(dets):
            # If a 3D pose is available, prefer it; otherwise fall back to image-space proxy.
            pose = d.get("pose")
            label = d.get("name", d.get("cls_id", -1))
            conf = float(d.get("conf", 0.0))
            theta = float(d.get("theta", 0.0))

            m = Marker()
            m.header = self.header()
            m.ns = "servo_detections"
            m.id = i
            m.type = Marker.CUBE
            m.action = Marker.ADD
            m.scale.x = 0.02
            m.scale.y = 0.02
            m.scale.z = 0.02
            m.color.r = 0.0
            m.color.g = 1.0
            m.color.b = 0.0
            m.color.a = 0.35

            if pose and isinstance(pose, dict):
                self._pose_to_marker_pose(m, pose)
                # Use the estimated 3D pose as-is
                if "size" in d:
                    size = d["size"]
                    if isinstance(size, (list, tuple)) and len(size) >= 2:
                        # Keep cube visible, but do not interpret pixel size as metric.
                        m.scale.x = max(float(size[0]) / 5000.0, 0.01)
                        m.scale.y = max(float(size[1]) / 5000.0, 0.01)
                        m.scale.z = 0.02
            else:
                cx, cy = d.get("center", [0.0, 0.0])
                w, h = d.get("size", [0.0, 0.0])
                m.pose.position.x = float(cx) / 500.0
                m.pose.position.y = float(cy) / 500.0
                m.pose.position.z = 0.0
                m.pose.orientation.w = 1.0
                m.scale.x = max(float(w) / 500.0, 0.001)
                m.scale.y = max(float(h) / 500.0, 0.001)
                m.scale.z = 0.01

            markers.markers.append(m)
            markers.markers.append(
                self._make_text_marker(
                    "servo_detections_text",
                    1000 + i,
                    m.pose.position.x,
                    m.pose.position.y,
                    m.pose.position.z + 0.04,
                    f"{label} {conf:.2f} th={theta:.2f}",
                    0.0,
                    1.0,
                    0.0,
                )
            )

        return markers

    def servo_target_to_marker(self, target_uv: List[float]) -> Marker:
        m = Marker()
        m.header = self.header()
        m.ns = "servo_target"
        m.id = 0
        m.type = Marker.SPHERE
        m.action = Marker.ADD
        m.pose.position.x = float(target_uv[0]) / 500.0
        m.pose.position.y = float(target_uv[1]) / 500.0
        m.pose.position.z = 0.0
        m.pose.orientation.w = 1.0
        m.scale.x = 0.02
        m.scale.y = 0.02
        m.scale.z = 0.02
        m.color.r = 1.0
        m.color.g = 1.0
        m.color.b = 0.0
        m.color.a = 1.0
        return m

    def wellplates_to_markers(self, dets: List[Dict[str, Any]]) -> MarkerArray:
        markers = MarkerArray()

        clear = Marker()
        clear.action = Marker.DELETEALL
        markers.markers.append(clear)

        for i, d in enumerate(dets):
            m = Marker()
            m.header = self.header()
            m.ns = "wellplates"
            m.id = i
            m.type = Marker.CUBE
            m.action = Marker.ADD

            pose = d.get("pose")
            if pose and isinstance(pose, dict):
                self._pose_to_marker_pose(m, pose)
            else:
                cx, cy = d.get("center", [0.0, 0.0])
                m.pose.position.x = float(cx) / 500.0
                m.pose.position.y = float(cy) / 500.0
                m.pose.position.z = 0.0
                m.pose.orientation.w = 1.0

            # Prefer metric size if the server provides it; otherwise keep a visible placeholder.
            size = d.get("metric_size", d.get("size", [0.0, 0.0]))
            if isinstance(size, (list, tuple)) and len(size) >= 2:
                sx = float(size[0])
                sy = float(size[1])
                # If these are image-space pixels, the values will be huge; keep a fallback cap.
                if sx > 1.0 or sy > 1.0:
                    sx = max(sx / 5000.0, 0.05)
                    sy = max(sy / 5000.0, 0.05)
                m.scale.x = max(sx, 0.01)
                m.scale.y = max(sy, 0.01)
            else:
                m.scale.x = 0.1
                m.scale.y = 0.06
            m.scale.z = 0.01

            m.color.g = 1.0
            m.color.a = 0.8
            markers.markers.append(m)

            markers.markers.append(
                self._make_text_marker(
                    "wellplates_text",
                    1000 + i,
                    m.pose.position.x,
                    m.pose.position.y,
                    m.pose.position.z + 0.03,
                    f"{d.get('name', d.get('cls_id', -1))} {float(d.get('conf', 0.0)):.2f}",
                    0.0,
                    1.0,
                    0.0,
                )
            )

        return markers

    def apriltags_to_markers(self, tags: List[Dict[str, Any]]) -> MarkerArray:
        markers = MarkerArray()

        clear = Marker()
        clear.action = Marker.DELETEALL
        markers.markers.append(clear)

        for i, t in enumerate(tags):
            m = Marker()
            m.header = self.header()
            m.ns = "apriltags"
            m.id = t.get("id")
            m.type = Marker.SPHERE
            m.action = Marker.ADD

            pose = t.get("pose")
            if pose and isinstance(pose, dict) and "position" in pose and "orientation" in pose:
                self._pose_to_marker_pose(m, pose)
            else:
                cx, cy = t.get("center", [0.0, 0.0])
                m.pose.position.x = float(cx) / 500.0
                m.pose.position.y = float(cy) / 500.0
                m.pose.position.z = 0.0
                m.pose.orientation.w = 1.0

            m.scale.x = 0.02
            m.scale.y = 0.02
            m.scale.z = 0.02
            m.color.r = 1.0
            m.color.a = 1.0
            markers.markers.append(m)

        return markers

    def publish_servo(self, data: Dict[str, Any]):
        img = self.decode_image(data.get("image_jpeg_b64", ""))
        if img is None:
            return

        ros_img = self.bridge.cv2_to_imgmsg(img, encoding="bgr8")
        ros_img.header = self.header()
        self.servo_image_pub.publish(ros_img)

        # Publish an annotated copy too so you can debug with image viewers.
        ann = img.copy()
        for det in data.get("detections", []):
            cx, cy = det.get("center", [0, 0])
            cv2.circle(ann, (int(cx), int(cy)), 6, (0, 255, 0), -1)
            cv2.putText(
                ann,
                f"cls={det.get('cls_id', -1)} {float(det.get('conf', 0.0)):.2f}",
                (int(cx) + 8, int(cy) - 8),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2,
            )
        target_uv = data.get("target_uv", [0.0, 0.0])
        cv2.drawMarker(
            ann,
            (int(target_uv[0]), int(target_uv[1])),
            (0, 255, 255),
            markerType=cv2.MARKER_CROSS,
            markerSize=20,
            thickness=2,
        )
        ros_ann = self.bridge.cv2_to_imgmsg(ann, encoding="bgr8")
        ros_ann.header = self.header()
        self.servo_annot_pub.publish(ros_ann)

        self.servo_det_pub.publish(self.servo_detections_to_markers(data.get("detections", [])))
        self.servo_target_pub.publish(self.servo_target_to_marker(target_uv))

    def publish_inspect(self, data: Dict[str, Any]):
        img = self.decode_image(data.get("image_jpeg_b64", ""))
        if img is None:
            return

        ros_img = self.bridge.cv2_to_imgmsg(img, encoding="bgr8")
        ros_img.header = self.header()
        self.inspect_image_pub.publish(ros_img)

        ann = img.copy()
        for det in data.get("wellplates", []):
            cx, cy = det.get("center", [0, 0])
            w, h = det.get("size", [0, 0])
            cv2.rectangle(
                ann,
                (int(cx - w / 2), int(cy - h / 2)),
                (int(cx + w / 2), int(cy + h / 2)),
                (0, 255, 0),
                2,
            )
            cv2.putText(
                ann,
                f"{det.get('name', det.get('cls_id', -1))} {float(det.get('conf', 0.0)):.2f}",
                (int(cx) + 5, int(cy) - 5),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2,
            )

        for tag in data.get("apriltags", []):
            cx, cy = tag.get("center", [0, 0])
            cv2.circle(ann, (int(cx), int(cy)), 5, (0, 0, 255), -1)
            cv2.putText(
                ann,
                f"ID {tag.get('id', -1)}",
                (int(cx) + 5, int(cy) + 15),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 0, 255),
                2,
            )

        ros_ann = self.bridge.cv2_to_imgmsg(ann, encoding="bgr8")
        ros_ann.header = self.header()
        self.inspect_annot_pub.publish(ros_ann)

        pc = self.decode_pointcloud(
            data.get("pointcloud_zlib_b64", ""),
            data.get("pointcloud_shape", [0, 0]),
            data.get("pointcloud_dtype", "float32"),
        )
        if pc is not None:
            self._pcs = pc
            if USE_PC_CACHE:
                np.save(PC_CACHE_PATH, self._pcs)

        if self._pcs is not None:
            self.inspect_pc_pub.publish(self.create_pc2(self._pcs))
            self._publish_merged()

        self.inspect_wp_pub.publish(self.wellplates_to_markers(data.get("wellplates", [])))
        self.inspect_tag_pub.publish(self.apriltags_to_markers(data.get("apriltags", [])))

    def _handle_message(self, raw: str):
        if not rclpy.ok():
            return
        try:
            data = json.loads(raw)
            msg_type = data.get("type", "")
            if msg_type == "servo_frame":
                self.publish_servo(data)
            elif msg_type == "inspect_frame":
                self.publish_inspect(data)
            elif msg_type == "idle":
                pass
            else:
                self.get_logger().debug(f"Unknown message type: {msg_type}")
        except Exception as e:
            self.get_logger().error(f"Message handling error: {e}")

    async def run(self):
        spin_task = asyncio.create_task(self._spin_ros())
        try:
            while rclpy.ok():
                try:
                    async with websockets.connect(
                        WS_URI,
                        max_size=None,
                        ping_interval=None,
                        ) as ws:
                        self.get_logger().info(f"Connected to {WS_URI}")
                        async for msg in ws:
                            self._handle_message(msg)

                except (websockets.ConnectionClosedError, websockets.InvalidStatusCode) as e:
                    self.get_logger().warn(f"WebSocket connection error, retrying: {e}")
                    await asyncio.sleep(1.0)
                except Exception as e:
                    self.get_logger().error(f"Loop error: {e}")
                    await asyncio.sleep(0.1)
        finally:
            spin_task.cancel()
            try:
                await spin_task
            except asyncio.CancelledError:
                pass

    async def _spin_ros(self):
        while rclpy.ok():
            rclpy.spin_once(self, timeout_sec=0.01)
            await asyncio.sleep(0.001)


def main():
    rclpy.init()
    node = WSVisualizer()

    try:
        asyncio.run(node.run())
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
