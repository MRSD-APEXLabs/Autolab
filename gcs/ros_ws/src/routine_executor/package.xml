  <version>0.0.0</version>
  <description>GCS-side routine executor: sequences robot actions via the behavior tree</description>
  <maintainer email="gcs@todo.todo">gcs</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
