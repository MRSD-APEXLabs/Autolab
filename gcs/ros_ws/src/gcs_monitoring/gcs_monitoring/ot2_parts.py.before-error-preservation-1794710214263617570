"""Run the two OT-2 parts once per click; retain handoff state on disk."""
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import threading

COMMAND_TOPIC = 'cmd/lab_machine/ot2_parts'
STATUS_TOPIC = 'ot2/parts/status'


class Ot2PartsRunner:
    def __init__(self, publish, state_file=None):
        self.publish = publish
        self.state_file = Path(state_file or os.environ.get(
            'OT2_PARTS_STATE', '/home/gcs/.local/state/autolab/ot2_parts.json'))
        self.state_file.parent.mkdir(parents=True, exist_ok=True)
        self.lock = threading.Lock()
        self.busy = False
        self.last_message = ''
        self.emit()

    def snapshot(self):
        state = json.loads(self.state_file.read_text()) if self.state_file.exists() else {}
        stage = state.get('stage', 'idle')
        status = 'running' if self.busy else (
            'idle' if stage == 'prepared' else
            stage if stage in ('idle', 'completed', 'ready_for_part2') else 'needs_inspection')
        return dict(status=status, stage=stage, message=self.last_message,
                    error=state.get('error'), volume_ul=state.get('volume_ul'),
                    tip_index=state.get('tip_index'), source_tube=state.get('source_tube', 'A1'))

    def emit(self, error=None):
        try:
            payload = self.snapshot()
        except (ValueError, OSError) as exc:
            payload = dict(status='needs_inspection', error=str(exc))
        if error:
            payload['error'] = error
        self.publish(payload)

    def relay(self, payload):
        try:
            body = json.loads(payload)
            part = body.get('part')
            if part == 'status':
                self.emit()
                return
            if part != 'cleanup' and (type(part) is not int or part not in (1, 2)):
                raise ValueError('Choose part 1, part 2, or cleanup')
            tip = body.get('tip_index')
            volume = body.get('volume', 200)
            source_tube = body.get('source_tube', 'A1')
            if part == 1 and source_tube not in ('A1', 'A2', 'A3', 'A4'):
                raise ValueError('Source tube must be A1, A2, A3 or A4')
            if part == 1 and (type(tip) is not int or not 0 <= tip < 96):
                raise ValueError('Choose an unused tip index from 0 to 95')
            if part == 1 and (type(volume) not in (int, float) or
                              not math.isfinite(volume) or not 0 < volume <= 200):
                raise ValueError('Volume must be greater than 0 and at most 200 µL')
            if not self.lock.acquire(blocking=False):
                raise ValueError('An OT-2 part is already running')
            try:
                status = self.snapshot()['status']
                allowed = (('idle', 'completed', 'ready_for_part2', 'needs_inspection') if part == 'cleanup'
                           else ('idle', 'completed') if part == 1 else ('ready_for_part2',))
                if status not in allowed:
                    raise ValueError(f'Cannot start part {part} while status is {status}')
                self.busy = True
                self.last_message = f'Starting part {part}'
                self.emit()
                threading.Thread(target=self._run, args=(part, tip, volume, source_tube), daemon=True).start()
            except Exception:
                self.busy = False
                self.lock.release()
                raise
        except (ValueError, TypeError, AttributeError, OSError) as exc:
            self.emit(str(exc))

    def _run(self, part, tip, volume, source_tube):
        try:
            module = 'gcs_monitoring.ot2_cleanup' if part == 'cleanup' else f'gcs_monitoring.ot2_part{part}'
            cmd = [sys.executable, '-u', '-m', module,
                   '--state', str(self.state_file)]
            if part == 1:
                cmd += ['--tip-index', str(tip), '--volume', str(volume),
                        '--source-tube', source_tube]
            with subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                  text=True) as process:
                for line in process.stdout:
                    self.last_message = line.strip()[-1000:]
                    self.emit()
                if process.wait():
                    raise RuntimeError(self.last_message or f'Part {part} failed')
        except Exception as exc:
            state = json.loads(self.state_file.read_text()) if self.state_file.exists() else {}
            state.update(stage='needs_inspection', error=str(exc))
            self.state_file.write_text(json.dumps(state, indent=2) + '\n')
        finally:
            self.busy = False
            self.lock.release()
            self.emit()
