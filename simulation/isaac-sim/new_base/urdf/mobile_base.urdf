      <geometry>
        <mesh filename="../meshes/custom_meshes/Wheel_Front_Right_1.stl" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <!-- Cylinder default axis is Z; rotate so spin axis is Y -->
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0002" iyy="0.0001" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
