  <!-- =======================
       JOINTS
       ======================= -->

  <!-- Steering (continuous, axis Z) -->
  <joint name="Revolute_2" type="continuous">
    <origin xyz="0.50615805 0.105825 0.63185791" rpy="3.1415927 0 1.5707963"/>
    <parent link="base_link"/>
    <child link="Az_Front_right_1"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05"/>
  </joint>

  <joint name="Revolute_1" type="continuous">
    <origin xyz="-0.0012486 0.105825 0.63125626" rpy="-3.1415927 0 1.5707963"/>
    <parent link="base_link"/>
    <child link="Az_Front_Left_1"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05"/>
  </joint>

  <joint name="Revolute_5" type="continuous">
    <origin xyz="0.5059564 -0.401584 0.63125626" rpy="-3.1415927 0 -1.5707963"/>
    <parent link="base_link"/>
    <child link="Az_Back_Right_1"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05"/>
  </joint>

  <joint name="Revolute_6" type="continuous">
    <origin xyz="-0.0014556 -0.401584 0.63125626" rpy="-3.1415927 0 -1.5707963"/>
    <parent link="base_link"/>
    <child link="Az_Back_left_1"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05"/>
  </joint>

  <joint name="Fastened_3" type="fixed">
    <parent link="base_link"/>
    <child link="arm_shoulder_4_2"/>
    <origin xyz="0.12 1.16 -0.211" rpy="0 1.5707963 0"/> 
    <dynamics dont_collapse="true"/>
  </joint>

  <joint name="Fastened_4" type="fixed">
    <origin xyz="-0.28094319 -1.3564931 -0.37430478" rpy="0 0 0"/>
    <parent link="arm_shoulder_4_2"/> 
    <child link="arm_shoulder_4_1"/>
    <dynamics dont_collapse="true"/>
  </joint>

  <!-- Arm joints: keep as-is unless you want me to re-derive axes -->
  <joint name="Revolute_9" type="revolute">
    <origin xyz="0 0 0.04" rpy="0 0 1.5707963"/>
    <parent link="arm_shoulder_4_1"/>
    <child link="arm_shoulder241_1"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1" velocity="1" lower="-6.2831853" upper="6.2831853"/>
    <dynamics damping="0.02"/>
  </joint>

  <joint name="Revolute_10" type="revolute">
    <origin xyz="0 0.0775 -0.115" rpy="1.5707963 1.5707963 0"/>
    <parent link="arm_shoulder241_1"/>
    <child link="arm_elbow_4_1"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1" velocity="1" lower="-6.2831853" upper="6.2831853"/>
    <dynamics damping="0.02"/>
  </joint>

  <joint name="Revolute_11" type="revolute">
    <origin xyz="0.28467 -0.05322 0.00817" rpy="0 0 0"/>
    <parent link="arm_elbow_4_1"/>
    <child link="elbow2_p4_1"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1" velocity="1" lower="-6.2831853" upper="6.2831853"/>
    <dynamics damping="0.02"/>
  </joint>

  <joint name="Revolute_12" type="revolute">
    <origin xyz="-0.16933092 -0.08577945 0.06658" rpy="0 1.5707963 0"/>
    <parent link="elbow2_p4_1"/>
    <child link="wrist_1_p4_1"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1" velocity="1" lower="-6.2831853" upper="6.2831853"/>
    <dynamics damping="0.02"/>
  </joint>

  <joint name="Revolute_13" type="revolute">
    <origin xyz="0.00000123 0.00000102 -0.13555" rpy="-1.5707963 0 1.5707963"/>
    <parent link="wrist_1_p4_1"/>
    <child link="wrist_2_p4_1"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1" velocity="1" lower="-6.2831853" upper="6.2831853"/>
    <dynamics damping="0.02"/>
  </joint>

  <joint name="Revolute_14" type="revolute">
    <origin xyz="-0.07700037 0.07099971 0" rpy="1.5707963 0 0"/>
    <parent link="wrist_2_p4_1"/>
    <child link="end_effector_p4_1"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1" velocity="1" lower="-6.2831853" upper="6.2831853"/>
    <dynamics damping="0.02"/>
  </joint>

  <!-- Gripper mount (fixed) -->
  <joint name="Fastened_1" type="fixed">
    <origin xyz="0 0 -0.028" rpy="0 0 1.5707963"/>
    <parent link="end_effector_p4_1"/>
    <child link="gripper_v43_1"/>
  </joint>

  <!-- Gripper sliders (prismatic ±X in joint frames) -->
  <joint name="Slider_1" type="prismatic">
    <origin xyz="0.012847465 -0.00034428038 -0.060041234" rpy="1.5707963 0 1.6231719"/>
    <parent link="gripper_v43_1"/>
    <child link="Finger_left_2"/>
    <axis xyz="1 0 0"/>
    <limit effort="30" velocity="0.2" lower="0.0" upper="0.03"/>
    <dynamics damping="30" friction="1.0"/>
  </joint>

  <joint name="Slider_3" type="prismatic">
    <origin xyz="-0.014905513 -0.0017991878 -0.060041234" rpy="-1.5707963 0 1.6231719"/>
    <parent link="gripper_v43_1"/>
    <child link="Finger_right_2"/>
    <axis xyz="-1 0 0"/>
    <limit effort="30" velocity="0.2" lower="-0.03" upper="0.0"/>
    <dynamics damping="30" friction="1.0"/>
  </joint>

  <!-- Wheel spin (continuous, axis Y) -->
  <joint name="Revolute_4" type="continuous">
    <origin xyz="0 -0.02301875 -0.05794375" rpy="-1.5707963 0 0"/>
    <parent link="Az_Front_right_1"/>
    <child link="Wheel_Front_Right_1"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.02"/>
  </joint>

  <joint name="Revolute_3" type="continuous">
    <origin xyz="0 0.02301875 -0.05794375" rpy="-1.5707963 0 0"/>
    <parent link="Az_Front_Left_1"/>
    <child link="Wheel_Front_Left_1"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.02"/>
  </joint>

  <joint name="Revolute_8" type="continuous">
    <origin xyz="0 0.02301875 -0.05794375" rpy="-1.5707963 0 0"/>
    <parent link="Az_Back_Right_1"/>
    <child link="Wheel_Back_Right_1"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.02"/>
  </joint>

  <joint name="Revolute_7" type="continuous">
    <origin xyz="0 -0.02301875 -0.05794375" rpy="1.5707963 0 0"/>
    <parent link="Az_Back_left_1"/>
    <child link="Wheel_Back_Left_1"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.02"/>
  </joint>

</robot>