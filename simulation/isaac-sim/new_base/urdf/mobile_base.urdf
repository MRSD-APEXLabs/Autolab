<?xml version="1.0"?>
<robot name="mobile_base">
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 3.14159265358979 0"/>
  </joint>

  <!-- =======================
       BASE + SHOULDER (fixed)
       ======================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://new_base/meshes/custom_meshes/Chassis_1.stl" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.35" rpy="0 0 0"/>
      <geometry><box size="0.5 0.4 0.7"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="25.0"/> <inertia ixx="0.8" iyy="0.8" izz="0.8" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="arm_shoulder_4_2">
    <visual>
      <geometry>
        <mesh filename="package://new_base/meshes/custom_meshes/arm_shoulder_4_2.stl" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.3 0.25 0.3"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

    
  <link name="arm_shoulder_4_1">
    <visual>
      <geometry>
        <mesh filename="package://new_base/meshes/custom_meshes/arm_shoulder_4_1.stl" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="1e-3" iyy="1e-3" izz="1e-3" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>


  <!-- =======================
       AZIMUTH MODULES
       ======================= -->
  <link name="Az_Front_right_1">
    <visual>
      <geometry>
        <mesh filename="package://new_base/meshes/custom_meshes/Az_Front_right_1.stl" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.06" radius="0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

