ARG ISAAC_VERSION="6.0.1"
# expects context to be the root of the repository, i.e. AutoLab/. this is so we can access AutoLab/ros_ws/
FROM nvcr.io/nvidia/isaac-sim:${ISAAC_VERSION}
ARG ISAAC_VERSION
WORKDIR /isaac-sim

USER root
# isaac's ros2 launch run_isaacsim.launch.py hardcodes to search in this path, so we have to put the executables here
RUN mkdir -p /root/.local/share/ov/pkg/ && \
    ln -s /isaac-sim /root/.local/share/ov/pkg/isaac-sim-${ISAAC_VERSION}

# allows us to run isaac-sim as root
ENV OMNI_KIT_ALLOW_ROOT=1

# setup environment
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV ROS_DISTRO=jazzy

# setup timezone
RUN echo 'Etc/UTC' > /etc/timezone && \
    ln -s /usr/share/zoneinfo/Etc/UTC /etc/localtime && \
    apt-get update && \
    apt-get install -q -y --no-install-recommends tzdata && \
    rm -rf /var/lib/apt/lists/*

# install base packages
RUN apt-get update && apt-get install -q -y --no-install-recommends \
    dirmngr \
    gnupg2 \
    unzip \
    tmux \
    iputils-ping \
    net-tools \
    curl \
    emacs \
    vim \
    nano \
    gdb \
    xterm \
    tree \
    less \
    htop \
    jq \
    git \
    build-essential \
    cmake \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    meson \
    ninja-build \
    wget \
    libcgal-dev && \
    rm -rf /var/lib/apt/lists/*

# setup ros2 key
RUN set -eux; \
    key='C1CF6E31E6BADE8868B172B4F42ED6FBAB17C654'; \
    export GNUPGHOME="$(mktemp -d)"; \
    gpg --batch --keyserver keyserver.ubuntu.com --recv-keys "$key"; \
    mkdir -p /usr/share/keyrings; \
    gpg --batch --export "$key" > /usr/share/keyrings/ros2-latest-archive-keyring.gpg; \
    gpgconf --kill all; \
    rm -rf "$GNUPGHOME"

# setup ros2 apt source
RUN echo "deb [ signed-by=/usr/share/keyrings/ros2-latest-archive-keyring.gpg ] http://packages.ros.org/ros2/ubuntu noble main" > /etc/apt/sources.list.d/ros2-latest.list

# Install the ROS distribution native to Isaac Sim 6's Ubuntu 24.04 base.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libfreetype6-dev \
    libfontconfig1-dev \
    ros-jazzy-desktop \
    ros-dev-tools \
    python3-rosdep \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-tools \
    ros-jazzy-ackermann-msgs \
    ros-jazzy-topic-tools \
    ros-jazzy-grid-map \
    ros-jazzy-domain-bridge \
    ros-jazzy-moveit \
    zstd \
    python3-colcon-common-extensions && \
    rm -rf /var/lib/apt/lists/*

# install python packages
RUN /isaac-sim/python.sh -m pip install --upgrade pip && \
    /isaac-sim/python.sh -m pip install PyYAML tmuxp scipy \
    kconfiglib jinja2 empy==3.3.4 jsonschema pyros-genmsg packaging toml numpy future

ARG isaac_dir_name="IsaacSim-ros_workspaces-IsaacSim-${ISAAC_VERSION}"
# Install Isaac Sim ROS2 workspace so that we can run the isaacsim ROS package
RUN cd /tmp/ && \
    curl -L -O https://github.com/isaac-sim/IsaacSim-ros_workspaces/archive/refs/tags/IsaacSim-${ISAAC_VERSION}.zip && \
    unzip IsaacSim-${ISAAC_VERSION}.zip && \
    mv ${isaac_dir_name}/jazzy_ws /jazzy_ws && \
    cd /jazzy_ws && \
    . /opt/ros/jazzy/setup.sh && \
    colcon build --symlink-install && \
    rm -rf /tmp/IsaacSim-${ISAAC_VERSION}.zip /tmp/${isaac_dir_name}


# rm -rf /tmp/PegasusSimulator
ENV ISAACSIM_PATH=/isaac-sim
ENV ACCEPT_EULA="Y"
# ENV ISAACSIM_PYTHON=/isaac-sim/python.sh

RUN /isaac-sim/python.sh -m pip install lark-parser

# TMux config
RUN git clone https://github.com/tmux-plugins/tpm /root/.tmux/plugins/tpm

# copy FastDDS config
COPY docker/fastdds.xml /isaac-sim/fastdds.xml

# The ROS 2 launch package also searches this compatibility path.
RUN ln -s /isaac-sim /root/isaacsim

ARG UBUNTU_RELEASE_YEAR=24
ARG ZED_CUDA_MAJOR=12
ARG ZED_CUDA_MINOR=8
ARG ZED_SDK_VERSION=5.4.1
# Isaac Sim 6 does not expose a system CUDA toolkit. Install only the CUDA
# runtime libraries required by ZED instead of allowing the ZED installer to
# pull the much larger compiler, profiler, and Nsight toolchain.
RUN wget -q -O /tmp/cuda-keyring.deb https://developer.download.nvidia.com/compute/cuda/repos/ubuntu${UBUNTU_RELEASE_YEAR}04/x86_64/cuda-keyring_1.1-1_all.deb && \
  dpkg -i /tmp/cuda-keyring.deb && \
  apt-get update && \
  apt-get install -y --no-install-recommends cuda-libraries-${ZED_CUDA_MAJOR}-${ZED_CUDA_MINOR} && \
  rm -rf /var/lib/apt/lists/* /tmp/cuda-keyring.deb

# Install ZED SDK. CUDA is provided above, so skip the installer's toolkit
# detection (which checks for nvcc and otherwise installs the full toolkit).
RUN wget -q -O ZED_SDK_Linux_Ubuntu${UBUNTU_RELEASE_YEAR}.run https://download.stereolabs.com/zedsdk/${ZED_SDK_VERSION}/cu${ZED_CUDA_MAJOR}/ubuntu${UBUNTU_RELEASE_YEAR} && \
  chmod +x ZED_SDK_Linux_Ubuntu${UBUNTU_RELEASE_YEAR}.run && \
  ./ZED_SDK_Linux_Ubuntu${UBUNTU_RELEASE_YEAR}.run -- silent skip_cuda && \
  ln -sf /lib/x86_64-linux-gnu/libusb-1.0.so.0 /usr/lib/x86_64-linux-gnu/libusb-1.0.so && \
  rm ZED_SDK_Linux_Ubuntu${UBUNTU_RELEASE_YEAR}.run

# Build against Isaac Sim's Ubuntu/GCC runtime to prevent GLIBCXX ABI errors.
# Isaac Sim automatically searches /isaac-sim/extsUser for extensions.
COPY zed-isaac-sim /opt/zed-isaac-sim
RUN cd /opt/zed-isaac-sim && \
    ./build.sh && \
    mkdir -p /isaac-sim/extsUser && \
    cp -a exts/. /isaac-sim/extsUser/


# Cleanup. Prevent people accidentally doing git commits as root in Docker
RUN apt purge -y git && apt autoremove -y \
    && apt clean -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /isaac-sim
